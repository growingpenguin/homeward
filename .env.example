# Copy to .env.local and fill in (never commit real values).
# `neon link` / `neon env pull` writes these for you.

# Pooled connection: for the running app
DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<database>?sslmode=require
# Direct connection: for Flyway migrations and psql
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<direct-host>/<database>?sslmode=require
# Neon branch the URLs point to
NEON_BRANCH=<branch-id>
