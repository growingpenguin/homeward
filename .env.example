# Copy to .env.local and fill in (never commit real values).
# `neon link` / `neon env pull` writes these for you.

# Pooled connection: for the running app
DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<database>?sslmode=require
# Direct connection: for Flyway migrations and psql
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<direct-host>/<database>?sslmode=require
# Neon branch the URLs point to
NEON_BRANCH=<branch-id>

# App user (least privilege, created by V1). The running app connects as this user, never as the owner.
HOMEWARD_APP_DATABASE_URL=postgresql://homeward_app:<password>@<pooled-host>/<database>?sslmode=require
HOMEWARD_APP_DATABASE_URL_UNPOOLED=postgresql://homeward_app:<password>@<direct-host>/<database>?sslmode=require
HOMEWARD_APP_DB_PASSWORD=<generated locally, never committed>
